# THAALAM PLATFORM - ENVIRONMENT CONFIGURATION
# DO NOT COMMIT SENSITIVE SERVICE KEYS TO PUBLIC REPOSITORIES

# Supabase Project URL
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# Supabase Public Anonymous Key (safe to use on client-side)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional Server Port
PORT=3000
